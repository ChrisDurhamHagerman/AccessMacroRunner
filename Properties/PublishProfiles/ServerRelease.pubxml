<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <ServerPublishDirectory>\\ns-autodesk\c$\ADSK-Automation\Release</ServerPublishDirectory>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <GenerateManifests>false</GenerateManifests>
    <SignManifests>false</SignManifests>
  </PropertyGroup>

  <Target Name="ValidateProductionEmailSettings">
    <XmlPeek
      XmlInputPath="$(MSBuildProjectDirectory)\App.config"
      Query="/configuration/appSettings/add[@key='EmailDebugMode']/@value">
      <Output TaskParameter="Result" PropertyName="EmailDebugModeValue" />
    </XmlPeek>
    <Error
      Condition="'$(EmailDebugModeValue)' != 'false'"
      Text="Server publish blocked: App.config EmailDebugMode must be false. Current value: '$(EmailDebugModeValue)'." />
  </Target>

  <Target Name="BuildReleaseForServerPublish" DependsOnTargets="ValidateProductionEmailSettings">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Build"
      Properties="Configuration=Release;Platform=AnyCPU;GenerateManifests=false;SignManifests=false"
      RemoveProperties="PublishProfile;ServerPublishDirectory" />
  </Target>

  <Target Name="PublishToServer" DependsOnTargets="BuildReleaseForServerPublish">
    <Error
      Condition="!Exists('$(ServerPublishDirectory)')"
      Text="The AccessMacroRunner deployment folder '$(ServerPublishDirectory)' is unavailable. Confirm that the server is online and that the current Windows account can access the administrative share." />

    <PropertyGroup>
      <ServerBackupDirectory>$(ServerPublishDirectory)\Backup_$([System.DateTime]::Now.ToString('yyyyMMdd_HHmmss'))</ServerBackupDirectory>
    </PropertyGroup>

    <ItemGroup>
      <ExistingServerFiles Include="$(ServerPublishDirectory)\*.exe;$(ServerPublishDirectory)\*.dll;$(ServerPublishDirectory)\*.config" />
      <AccessMacroRunnerPublishFiles Include="$(MSBuildProjectDirectory)\bin\Release\*.exe;$(MSBuildProjectDirectory)\bin\Release\*.dll;$(MSBuildProjectDirectory)\bin\Release\*.config" />
    </ItemGroup>

    <MakeDir Directories="$(ServerBackupDirectory)" Condition="'@(ExistingServerFiles)' != ''" />
    <Copy
      SourceFiles="@(ExistingServerFiles)"
      DestinationFiles="@(ExistingServerFiles->'$(ServerBackupDirectory)\%(Filename)%(Extension)')"
      SkipUnchangedFiles="false"
      Condition="'@(ExistingServerFiles)' != ''" />
    <Copy
      SourceFiles="@(AccessMacroRunnerPublishFiles)"
      DestinationFiles="@(AccessMacroRunnerPublishFiles->'$(ServerPublishDirectory)\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Retries="3"
      RetryDelayMilliseconds="1000" />

    <Message
      Importance="high"
      Text="Published AccessMacroRunner to $(ServerPublishDirectory). Previous deployment backed up to $(ServerBackupDirectory)." />
  </Target>

  <Target Name="Publish" DependsOnTargets="PublishToServer" />
</Project>
